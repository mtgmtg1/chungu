# [Flow: Step 1 (개발용 환경변수 템플릿) -> Step 2 (app/.env.development 로 복사 후 값 채우기)]
# 이 파일을 app/.env.development 로 복사한 뒤 실제 값을 입력하세요.
# Vite는 .env.development를 자동으로 읽고, VITE_ 접두사 변수만 클라이언트에 노출합니다.

# --- 로컬 개발 백엔드 연결 ---
# 내부망 직접 연결: a1 백엔드
VITE_DEV_BACKEND_URL=http://192.168.1.50:28181
# SSH 터널링 사용 시 아래 주석을 해제
# VITE_DEV_BACKEND_URL=http://localhost:28181

# --- Supabase (프론트엔드) ---
# a1의 Supabase URL과 anon key를 입력하세요.
VITE_SUPABASE_URL=http://192.168.1.50:28000
VITE_SUPABASE_ANON_KEY=eyJ...

# --- Turnstile (개발 환경에서 필요한 경우) ---
# 빈 값으로 두면 CAPTCHA 미사용. a1 .env에 DEV_BYPASS_AUTH=true가 설정되어 있으면 자동 로그인됨.
VITE_TURNSTILE_SITE_KEY=
VITE_TURNSTILE_WORKER_URL=
