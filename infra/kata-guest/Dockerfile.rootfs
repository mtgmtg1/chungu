# PROOF 에이전트 게스트 rootfs 이미지 빌드용 Dockerfile
#
# [Flow: Stage 1 (Debian 기반 패키지 설치) -> Stage 2 (Python/Node.js 환경) -> Stage 3 (rootfs export)]
#
# 이 Dockerfile 은 컨테이너 이미지 자체가 아니라 Kata 게스트 VM 의 rootfs 를 빌드하기 위해 사용한다.
# 빌드 후 docker export 로 파일시스템을 추출하여 ext4 이미지로 변환한다.
#
# 사용법:
#   docker build -t proof-agent-rootfs -f Dockerfile.rootfs .
#   docker export $(docker create proof-agent-rootfs) | sudo tar -x -C /tmp/rootfs
#   sudo mkfs.ext4 -d /tmp/rootfs /opt/kata/share/kata-containers/proof-agent.img 3G

FROM debian:12-slim

# ========================================
# Stage 0: systemd + kata-agent 설치
# ========================================
# Kata 게스트 VM 은 systemd (PID 1) 가 init 로 실행되고
# kata-agent 는 systemd 서비스로 실행된다.
# 기본 Kata Ubuntu 이미지와 동일한 구성을 사용한다.

# systemd + dbus 설치 (systemd-sysv 가 /sbin/init -> systemd 심볼릭 링크 생성)
# dbus: kata-agent 가 cgroup 관리를 위해 D-Bus 시스템 버스에 연결해야 함.
#   dbus 없으면 "Establishing a D-Bus connection: No such file or directory" 로 shim 실패.
RUN apt-get update && apt-get install -y --no-install-recommends \
    systemd systemd-sysv dbus \
    && rm -rf /var/lib/apt/lists/*

# kata-agent 바이너리 주입 (호스트에서 추출한 Kata 3.31.0 빌드, static-pie)
COPY kata-agent /usr/bin/kata-agent
RUN chmod +x /usr/bin/kata-agent

# kata-agent OPA 정책 파일 (allow-all) — 없으면 kata-agent 가 종료됨
COPY allow-all.rego /etc/kata-opa/allow-all.rego
RUN ln -sf allow-all.rego /etc/kata-opa/default-policy.rego

# kata-agent systemd 서비스 등록 (기본 Kata 이미지와 동일한 설정)
COPY kata-agent.service /usr/lib/systemd/system/kata-agent.service
COPY kata-containers.target /usr/lib/systemd/system/kata-containers.target
RUN systemctl enable kata-agent.service 2>/dev/null || true && \
    systemctl set-default kata-containers.target 2>/dev/null || true && \
    mkdir -p /etc/systemd/system/basic.target.wants && \
    ln -sf /usr/lib/systemd/system/kata-containers.target \
       /etc/systemd/system/basic.target.wants/kata-containers.target

# tmp.mount — kata-containers.target 이 Requires=tmp.mount 로 의존.
#   tmpfs /tmp 가 없으면 kata-agent 가 정책 초기화 중 /tmp/policy.jsonl 에 쓰지 못해
#   "Failed to initialize agent policy: Read-only file system (os error 30)" 로 종료됨.
#   Debian 12 slim 에는 tmp.mount 유닛이 기본 설치되지 않으므로 수동 생성.
RUN printf '[Unit]\n\
Description=Temporary Directory\n\
Documentation=man:hier(7)\n\
ConditionPathIsSymbolicLink=!/tmp\n\
DefaultDependencies=no\n\
Conflicts=umount.target\n\
Before=local-fs.target umount.target\n\
After=swap.target\n\
\n\
[Mount]\n\
What=tmpfs\n\
Where=/tmp\n\
Type=tmpfs\n\
Options=mode=1777,strictatime,nosuid,nodev\n' > /usr/lib/systemd/system/tmp.mount

# dbus.socket 을 kata-containers.target.wants 에 등록.
#   kata-agent 가 D-Bus 시스템 버스에 연결하려면 dbus.socket 이 kata-containers.target
#   시작 시점에 활성화되어야 함 (기본 Kata Ubuntu 이미지와 동일한 구성).
RUN mkdir -p /etc/systemd/system/kata-containers.target.wants && \
    ln -sf /usr/lib/systemd/system/dbus.socket \
       /etc/systemd/system/kata-containers.target.wants/dbus.socket

# 불필요한 systemd 서비스 비활성화 (게스트 VM 경량화)
RUN find /etc/systemd/system /lib/systemd/system \
    -path '*/multi-user.target.wants/*' \
    ! -name 'kata-agent.service' \
    -exec rm -f {} \; 2>/dev/null || true && \
    rm -f /lib/systemd/system/systemd-resolved.service \
          /lib/systemd/system/systemd-networkd.service \
          /lib/systemd/system/systemd-timesyncd.service 2>/dev/null || true

# Docker 빌드 아티팩트 제거 (systemd 가 docker 가상화로 잘못 감지하는 것 방지)
# .dockerenv, /run/docker 등 Docker 가 남기는 파일들을 제거한다.
RUN rm -f /.dockerenv /dockerenv 2>/dev/null || true && \
    rm -rf /run/* 2>/dev/null || true

# machine-id 생성 (systemd 부팅에 필요)
RUN echo "b6a3c8e5f2d14e7a9b1c3d5e7f9a1b3c" > /etc/machine-id && \
    ln -sf /etc/machine-id /var/lib/dbus/machine-id 2>/dev/null || true

# ========================================
# Stage 1: 시스템 패키지 설치 (문서/오디오/이미지 처리)
# ========================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    # --- 기본 도구 ---
    git curl wget jq unzip unrar-free p7zip-full \
    ca-certificates locales xsltproc libxml2-utils \
    build-essential gcc make cmake pkg-config \
    # --- 문서 처리 ---
    libreoffice-writer libreoffice-calc libreoffice-impress \
    libreoffice-l10n-ko libreoffice-l10n-ja libreoffice-l10n-zh-cn \
    libreoffice-help-ko \
    pandoc poppler-utils \
    tesseract-ocr tesseract-ocr-kor tesseract-ocr-eng \
    tesseract-ocr-jpn tesseract-ocr-chi-sim tesseract-ocr-chi-tra \
    # --- 오디오/비디오 처리 ---
    ffmpeg \
    # --- 이미지 처리 ---
    imagemagick ghostscript \
    # --- 폰트 (한글/중문/일문 렌더링 필수) ---
    fonts-noto-cjk fonts-nanum fonts-unfonts-core \
    fonts-noto-color-emoji fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# ========================================
# Stage 2: 로케일 설정
# ========================================
RUN sed -i 's/^# *\(ko_KR.UTF-8\)/\1/' /etc/locale.gen && \
    sed -i 's/^# *\(ja_JP.UTF-8\)/\1/' /etc/locale.gen && \
    sed -i 's/^# *\(zh_CN.UTF-8\)/\1/' /etc/locale.gen && \
    locale-gen
ENV LANG=ko_KR.UTF-8
ENV LC_ALL=ko_KR.UTF-8

# ========================================
# Stage 3: Python 환경 (문서/오디오/이미지 처리 라이브러리)
# ========================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv python3-dev \
    libgl1-mesa-glx libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir --break-system-packages \
    # --- 문서 처리 ---
    markitdown pymupdf pdf2image \
    # --- 오디오 처리 ---
    faster-whisper pydub librosa \
    # --- 이미지 처리 ---
    Pillow opencv-python-headless \
    # --- 유틸리티 ---
    requests httpx websockets \
    # --- browserless 원격 연결 ---
    pyppeteer

# Whisper small 모델 사전 다운로드 (런타임 다운로드 방지)
RUN python3 -c "from faster_whisper import WhisperModel; WhisperModel('small', device='cpu', compute_type='int8')" 2>/dev/null || true

# ========================================
# Stage 4: Node.js 환경
# ========================================
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

# browserless 원격 연결용 puppeteer-core (로컬 Chrome 설치 불필요)
RUN npm install -g puppeteer-core

# ========================================
# Stage 5: 비특권 사용자 생성
# ========================================
RUN useradd -m -s /bin/bash -u 1000 agent && \
    mkdir -p /workspace /home/agent/.config && \
    chown agent:agent /workspace /home/agent/.config

# sudo 설치하지 않음 (root 전환 불가)

# ========================================
# Stage 6: 에이전트 런타임 스크립트
# ========================================
COPY entrypoint.sh /opt/agent-runner/entrypoint.sh
COPY browserless-helper.py /opt/agent-runner/browserless-helper.py
COPY browserless-helper.js /opt/agent-runner/browserless-helper.js
RUN chmod +x /opt/agent-runner/entrypoint.sh /opt/agent-runner/browserless-helper.py && \
    chown -R agent:agent /opt/agent-runner

# ========================================
# Stage 7: 환경 변수
# ========================================
ENV BROWSERLESS_URL=http://192.168.1.50:20047
ENV PYTHONUNBUFFERED=1
ENV NODE_ENV=production

# 작업 디렉토리
WORKDIR /workspace

# Kata 게스트 VM 은 systemd (PID 1) 가 kata-agent 서비스를 실행한다.
# 컨테이너 ENTRYPOINT / USER 지정 불필요 — build-rootfs.sh 가 docker export 로
# 파일시스템만 추출하여 ext4 이미지로 변환한다.
